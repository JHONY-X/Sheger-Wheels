# Copy to .env.local for local overrides. Nothing here is a secret.
#
# Public origin used for canonical URLs, Open Graph metadata, JSON-LD and the
# sitemap. Leave it unset for localhost; set it to the deployed origin so
# crawlers see absolute URLs that match the serving domain.
NEXT_PUBLIC_SITE_URL=https://sheggar-wheels.vercel.app

# The demo has no database, no auth provider and no payment keys on purpose.
# Do not add real credentials: every booking, payment and review is simulated in
# the browser (see README.md and BOUNDARY.md). No variable is required to run
# `npm run dev`.
